{
  "name": "standoff",
  "productName": "Standoff",
  "version": "0.1.1",
  "description": "Two-player buzzer quiz kiosk",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Standoff",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "build": "npm run build:renderer && npm run build:admin",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "test": "node --test test/*.test.js",
    "dev:admin": "vite --config vite.admin.config.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "trystero": "^0.25.4",
    "vite": "^8.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
